PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
CORS_ORIGIN=*
DISPATCH_WINDOW_SECONDS=30
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_PUBLIC_KEY=your_chapa_public_key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret
CHAPA_RETURN_URL=https://example.com/payment/return
CHAPA_CALLBACK_URL=https://example.com/payment/callback

# Required for manual-address order requests — geocodes what the Visitor
# types into coordinates so nearby agents can be found. Get one at
# https://console.cloud.google.com/google/maps-apis (enable "Geocoding API").
GEOCODING_API_KEY=your_google_geocoding_api_key

# Powers the real map (tiles + pins) in the app's broker map screen.
# Get one at https://console.gebeta.app — the server hands this to the
# Flutter app at runtime via GET /api/config/map, so it never has to be
# hardcoded into the frontend source.
GEBETA_MAPS_API_KEY=your_gebeta_maps_jwt_key

# Sends the "Forgot password" reset code and the signup "verify your
# email" code, via Brevo's transactional email HTTP API (not SMTP — see
# src/services/mailer.js for why). Until BREVO_API_KEY is filled in, both
# codes are just logged to the server console instead — the flows still
# work end-to-end for local testing, they just won't email anyone.
#
# Get an API key at https://app.brevo.com/settings/keys/api, and verify
# BREVO_SENDER_EMAIL as a sender (or verify the whole domain) under
# Senders, Domains & Dedicated IPs in the Brevo dashboard first — Brevo
# rejects sends from an unverified "from" address.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=EBN

# Secures GET /api/cron/sweep (the daily rental-agreement / tour-request /
# investment-payout sweep — see vercel.json's `crons` entry and
# src/routes/cron.js). Vercel does NOT auto-generate this for you — set
# it yourself (any random string, 16+ chars) in the Vercel dashboard
# under Project Settings > Environment Variables. Vercel then echoes it
# back as `Authorization: Bearer $CRON_SECRET` on every scheduled call.
# Leave it unset and the route always 503s, so the daily sweep silently
# never runs.
CRON_SECRET=replace-with-a-long-random-string
